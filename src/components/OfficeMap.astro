---
import type { Messages } from '../i18n/types';
import { OFFICE_MAP_URL, officeMapEmbedUrl } from '../i18n/contact';

interface Props {
	messages: Messages;
}

const { messages } = Astro.props;
const embedUrl = officeMapEmbedUrl(messages.lang === 'uz' ? 'uz_UZ' : 'en_US');
---

<section class="section section--tight office-section" id="office" aria-labelledby="office-heading">
	<div class="wrap office-grid">
		<div>
			<p class="eyebrow">{messages.nav.office}</p>
			<h2 id="office-heading" class="heading-lg">{messages.office.heading}</h2>
			<p class="muted intro-copy">{messages.office.intro}</p>
			<p class="office-address__label">{messages.office.addressLabel}</p>
			<address class="office-address">{messages.office.address}</address>
			<a class="btn btn--ghost office-directions" href={OFFICE_MAP_URL} rel="noopener noreferrer" target="_blank">
				{messages.office.directions}
			</a>
		</div>
		<div class="office-map">
			<iframe
				src={embedUrl}
				title={messages.office.mapTitle}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen></iframe>
		</div>
	</div>
</section>

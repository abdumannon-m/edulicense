---
import type { CardRow, CardState } from '../i18n/types';

interface Props {
	title: string;
	rows: CardRow[];
	stateLabels: Record<CardState, string>;
	tag?: string;
}

const { title, rows, stateLabels, tag } = Astro.props;
---

<div class="card">
	<div class="card__head">
		<span class="card__title">{title}</span>
		{tag && <span class="pill">{tag}</span>}
	</div>
	<ul class="card__rows" role="list">
		{
			rows.map((row) => (
				<li class={`card__row is-${row.state}`}>
					<span class="state" aria-hidden="true" />
					<span class="card__label">{row.label}</span>
					<span class="card__value">
						{row.value}
						<span class="sr">({stateLabels[row.state]})</span>
					</span>
				</li>
			))
		}
	</ul>
</div>

---
import type { Messages } from '../i18n/types';
import { CONTACT_EMAIL, OFFICE_MAP_URL, telegramEnabled, telegramUrl, whatsappUrl } from '../i18n/contact';

interface Props {
	messages: Messages;
}

const { messages: m } = Astro.props;
const wa = whatsappUrl(m.hero.whatsappPrefill);
const homePath = m.lang === 'uz' ? '/uz' : '/';
const privacyPath = m.lang === 'uz' ? '/uz/privacy' : '/privacy';
const otherHome = m.lang === 'uz' ? '/' : '/uz';
const otherLang = m.lang === 'uz' ? 'en' : 'uz';
const otherLabel = m.lang === 'uz' ? m.nav.switchToEn : m.nav.switchToUz;
---

<footer class="footer">
	<div class="wrap footer__grid">
		<div class="footer__brand">
			<a class="nav__brand" href={homePath}><span class="nav__mark" aria-hidden="true"><img src="/logo.png" alt="" width="24" height="24" /></span>{m.brandShort}</a>
			<p>{m.footer.tagline}</p>
		</div>
		<div>
			<h2 class="footer__label">{m.footer.contactLabel}</h2>
			<ul role="list">
				<li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
				<li><a href={wa} rel="noopener noreferrer" target="_blank">{m.footer.whatsapp}</a></li>
				{telegramEnabled() && <li><a href={telegramUrl()} rel="noopener noreferrer" target="_blank">{m.footer.telegram}</a></li>}
			</ul>
		</div>
		<div>
			<h2 class="footer__label">{m.footer.addressLabel}</h2>
			<address>{m.footer.address}</address>
			<a href={OFFICE_MAP_URL} rel="noopener noreferrer" target="_blank">{m.footer.directions}</a>
		</div>
		<div>
			<h2 class="footer__label">{m.footer.pagesLabel}</h2>
			<ul role="list">
				<li><a href={privacyPath}>{m.footer.privacy}</a></li>
				<li><a href={otherHome} hreflang={otherLang} lang={otherLang}>{otherLabel}</a></li>
			</ul>
		</div>
	</div>
	<div class="wrap footer__bottom">© {new Date().getFullYear()} {m.brandLegal}. {m.footer.rights}</div>
</footer>
